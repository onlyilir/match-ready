<Window x:Class="MatchReady.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match Ready" Width="480" Height="660" ResizeMode="CanMinimize"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid x:Name="Shell" Margin="24,18,24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: name, version, Boost | Pro -->
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="{DynamicResource SurfaceBrush}" CornerRadius="9" Padding="3" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TabBoost" Style="{StaticResource SegmentButton}" GroupName="Tabs" IsChecked="True"
                                     Content="Boost" AutomationProperties.Name="Boost tab"/>
                        <RadioButton x:Name="TabPro" Style="{StaticResource SegmentButton}" GroupName="Tabs"
                                     Content="Pro" AutomationProperties.Name="Pro tips tab"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Match Ready" Style="{StaticResource Title}"/>
                    <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="8,0,0,4" VerticalAlignment="Bottom"/>
                </StackPanel>
            </DockPanel>
            <TextBlock Grid.Row="1" Text="FACEIT-safe: never touches the game or the anti-cheat." Style="{StaticResource Muted}" Margin="0,2,0,14"/>

            <!-- Insider build note -->
            <Border x:Name="InsiderCard" Grid.Row="2" Style="{StaticResource WarnCard}" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="InsiderText" TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
                    <Button Content="Got it" Style="{StaticResource LinkButton}" Foreground="{DynamicResource WarnBrush}"
                            HorizontalAlignment="Right" Margin="0,6,0,0" Click="InsiderOk_Click"/>
                </StackPanel>
            </Border>

            <!-- ============ Boost page ============ -->
            <DockPanel x:Name="BoostPage" Grid.Row="3" LastChildFill="True">
                <Button x:Name="MainButton" DockPanel.Dock="Top" Style="{StaticResource BigButton}" Content="BOOST MY GAME"
                        Click="MainButton_Click" AutomationProperties.Name="Boost my game"/>

                <!-- Status: the coloured left edge shows the state (grey idle, green boosted, yellow working) -->
                <Border x:Name="StatusCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,14,0,0"
                        BorderThickness="4,0,0,0" BorderBrush="{DynamicResource MutedBrush}" AutomationProperties.LiveSetting="Polite">
                    <StackPanel>
                        <TextBlock x:Name="StatusTitle" Text="Ready" FontFamily="{StaticResource DisplayFont}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Live dashboard while a boost is on -->
                <Border x:Name="Dashboard" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Boost on for" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="DashTime" Text="0:00" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Free RAM" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="DashRam" Text="–" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                                <TextBlock x:Name="DashRamDelta" Foreground="{DynamicResource AccentBrush}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="CPU in use" Style="{StaticResource Muted}"/>
                                <TextBlock x:Name="DashCpu" Text="–" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource DisplayFont}"/>
                            </StackPanel>
                        </Grid>
                        <Canvas x:Name="CpuChart" Height="34" Margin="0,10,0,0" ClipToBounds="True" SnapsToDevicePixels="True">
                            <Polyline x:Name="CpuLine" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round"/>
                        </Canvas>
                        <TextBlock Text="Whole-PC CPU, last 2 minutes" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Warnings (RTSS, Ryzen Master…) -->
                <Border x:Name="WarnCard" DockPanel.Dock="Top" Style="{StaticResource WarnCard}" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="WarnText" TextWrapping="Wrap" FontSize="13" LineHeight="18"/>
                </Border>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="What was stopped" Style="{StaticResource LinkButton}" Click="Stopped_Click"/>
                    <Button Content="Settings" Style="{StaticResource LinkButton}" Margin="22,0,0,0" Click="Settings_Click"/>
                    <Button Content="Help" Style="{StaticResource LinkButton}" Margin="22,0,0,0" Click="Help_Click"/>
                    <Button Content="About" Style="{StaticResource LinkButton}" Margin="22,0,0,0" Click="About_Click"/>
                </StackPanel>

                <!-- Auto mode -->
                <StackPanel DockPanel.Dock="Bottom">
                    <CheckBox x:Name="AutoSwitch" Style="{StaticResource Switch}" FontWeight="SemiBold" FontSize="15"
                              Checked="AutoSwitch_Changed" Unchecked="AutoSwitch_Changed" AutomationProperties.Name="Auto mode">
                        <TextBlock Text="Auto mode"/>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Muted}" Margin="54,4,0,0"
                               Text="Boosts when CS2 starts and restores when it closes, even with this window closed (it stays in the tray)."/>
                </StackPanel>

                <Border/>
            </DockPanel>

            <!-- ============ Pro page ============ -->
            <ScrollViewer x:Name="ProPage" Grid.Row="3" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel x:Name="ProList" Margin="0,0,6,0"/>
            </ScrollViewer>
        </Grid>

        <!-- First run / quick setup covers the window -->
        <ContentControl x:Name="Overlay" Visibility="Collapsed" Focusable="False"/>
    </Grid>
</Window>
