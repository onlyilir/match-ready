<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 is part of Windows 10/11, so Setup needs nothing installed.
       The app files are embedded; build\Build-Setup.ps1 fills ..\..\dist\ first. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MatchReady-Setup</AssemblyName>
    <RootNamespace>MatchReady.Installer</RootNamespace>
    <ApplicationIcon>..\..\assets\MatchReady.ico</ApplicationIcon>
    <ApplicationManifest>..\installer.manifest</ApplicationManifest>
    <Version>1.2.0</Version>
    <Product>Match Ready</Product>
    <Description>Match Ready Setup</Description>
    <DebugType>none</DebugType>
    <PayloadDir>$(MSBuildThisFileDirectory)..\..\dist\payload\</PayloadDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Shared\*.cs" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadDir)MatchReady.exe" LogicalName="payload/MatchReady.exe" />
    <EmbeddedResource Include="$(PayloadDir)Uninstall.exe" LogicalName="payload/Uninstall.exe" />
    <EmbeddedResource Include="$(PayloadDir)README.md" LogicalName="payload/README.md" />
    <EmbeddedResource Include="$(PayloadDir)FACEIT-NOTES.md" LogicalName="payload/FACEIT-NOTES.md" />
    <EmbeddedResource Include="$(PayloadDir)LICENSE.txt" LogicalName="payload/LICENSE.txt" />
  </ItemGroup>

</Project>
